diff --git a/ios/RCTWebRTC/ScreenCaptureController.m b/ios/RCTWebRTC/ScreenCaptureController.m
index 31c136ff1794dd8bfc03d2418abc43b66bcffa16..7920599a096be84a2c0d43145afd2f9e4ac9d575 100644
--- a/ios/RCTWebRTC/ScreenCaptureController.m
+++ b/ios/RCTWebRTC/ScreenCaptureController.m
@@ -1,5 +1,7 @@
 #if TARGET_OS_IOS
 
+#import <UIKit/UIKit.h>
+
 #import "ScreenCaptureController.h"
 #import "ScreenCapturer.h"
 #import "SocketConnection.h"
@@ -55,7 +57,18 @@ - (void)stopCapture {
 }
 
 - (NSDictionary *)getSettings {
-    return @{@"deviceId" : self.deviceId, @"groupId" : @"", @"frameRate" : @(30)};
+    // Diskort: boyut bildirilmezse livekit-client bir saniye bekleyip "could not determine track dimensions"
+    // hatası yazar ve yatay 1280x720 duyurur. Kısa kenar sınırı: modules/screen-broadcast/ios/extension/SampleHandler.swift
+    CGSize native = [UIScreen mainScreen].nativeBounds.size;
+    CGFloat shortSide = MIN(native.width, native.height);
+    CGFloat scale = shortSide > 720 ? 720 / shortSide : 1;
+    return @{
+        @"deviceId" : self.deviceId,
+        @"groupId" : @"",
+        @"frameRate" : @(30),
+        @"width" : @((NSInteger)round(native.width * scale)),
+        @"height" : @((NSInteger)round(native.height * scale))
+    };
 }
 // MARK: CapturerEventsDelegate Methods
 
