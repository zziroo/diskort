# Diskort'un HTTPS siteleri. Hem bu depodaki tek başına kurulum (infra/Caddyfile, `caddy` profili)
# hem de üretimdeki ortak giriş kapısı (ziroo-edge) bu dosyayı /etc/caddy/diskort/diskort.caddy olarak içe aktarır.
# Değişiklik `git pull` + `caddy reload` ile yayına girer (klasör bağlandığı için yeniden başlatma gerekmez).

# Otomatik Let's Encrypt sertifikalı HTTPS / WSS
{$DISKORT_DOMAIN} {
	encode zstd gzip

	# API, gerçek zamanlı gateway, indirme ve uygulama güncelleme yönlendirmeleri (/download/windows, /updates/latest.yml)
	@api path /api/* /gateway /download/* /updates/*
	handle @api {
		# Yeniden yüklemede açık gateway WebSocket'lerini hemen kesme (yoksa herkes aynı anda kopar)
		reverse_proxy 127.0.0.1:3000 {
			stream_close_delay 5m
		}
	}

	# Sunucuya özel ek yollar: /opt/ziroo-sites/<ad>.caddy (handle blokları), bu repo değişmeden `caddy reload`
	# ile yayına girer. Üretimde yalnız taşınan Diskort dışı projelerin eski adres yönlendirmeleri burada
	# (ziroo-edge deposu config/diskort-yollari/); projelerin kendisi tools.ziroo.net / games.ziroo.net altında.
	import /etc/caddy/sites/*.caddy

	# İndirme sayfası (apps/web); bilinmeyen yollar da sayfayı gösterir (/download dahil)
	handle {
		root * /srv/web
		try_files {path} {path}.html /index.html
		file_server
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		}
		header /assets/* Cache-Control "public, max-age=604800"
	}
}

{$LIVEKIT_DOMAIN} {
	# Yeniden yüklemede LiveKit sinyal WebSocket'lerini hemen kesme (sesli kanaldakiler kopmasın)
	reverse_proxy 127.0.0.1:7880 {
		stream_close_delay 5m
	}
}

# TURN alan adının sertifikasını almak için. Bu alan adına gelen 443 trafiği yukarıdaki
# katman-4 kuralıyla LiveKit'e gider; bu blok yalnızca sertifika yönetimi içindir.
{$TURN_DOMAIN} {
	respond "Diskort TURN" 404
}
